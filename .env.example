# Copy to .env and adjust. Development values matching compose.dev.yaml.
PORT=3000
# Address people use to open Orlok (links in emails). In development, the Vite dev server;
# use the LAN address (http://<lan-ip>:5173) when other devices need to open the links.
ORLOK_PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://orlok:orlok@127.0.0.1:5432/orlok
# 32-byte key (base64) that encrypts provider keys and credentials at rest (R-SEC-2).
# Generate with: openssl rand -base64 32 — keep it outside the database and back it up.
ORLOK_SECRET_KEY=
# Orlok runner (isolated container for commands, SSH and local MCP servers). `pnpm dev` starts it
# on 127.0.0.1:3100 with this development token; in production use a random token of 16+ characters.
ORLOK_RUNNER_URL=http://127.0.0.1:3100
ORLOK_RUNNER_TOKEN=orlok-dev-runner-token
