# Production settings for compose.yaml. Copy to .env.production (git-ignored), fill in the values
# and start with: docker compose --env-file .env.production up -d --build
# Never commit the filled-in file.

# Address people use to open Orlok (links in emails, CSRF check on uploads), e.g.
# https://orlok.example.com or http://10.0.1.20:8080. Behind a reverse proxy this is the
# proxy's address, and the proxy must forward X-Forwarded-Host and X-Forwarded-Proto.
ORLOK_PUBLIC_URL=

# Host port the app publishes (container port 3000).
ORLOK_PORT=8080

# 32-byte key (base64) that encrypts provider keys and credentials at rest.
# Generate with: openssl rand -base64 32
# Keep it outside the database and back it up: without it saved keys cannot be decrypted.
ORLOK_SECRET_KEY=

# Password of the Postgres user. It is part of a URL, so use URL-safe characters:
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: Postgres user and database, created on the first start (default: orlok).
# POSTGRES_USER=orlok
# POSTGRES_DB=orlok

# Shared token between the app and the runner, random and at least 32 characters:
# openssl rand -hex 32
ORLOK_RUNNER_TOKEN=

# Optional: threads of the built-in embedding model (default: half the cores, max 8).
# ORLOK_EMBEDDINGS_THREADS=4

# Optional: image names used when building/pulling.
# ORLOK_APP_IMAGE=orlok:latest
# ORLOK_RUNNER_IMAGE=orlok-runner:latest
